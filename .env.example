# Railway PostgreSQL (set automatically when you add a Postgres service)
DATABASE_URL=postgresql://user:pass@host:5432/railway
# DATABASE_PUBLIC_URL=postgresql://...  (use this for external connections)

# Clerk Authentication
CLERK_SECRET_KEY=sk_live_...

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JWT (fallback dev secret — used if Clerk is not configured)
JWT_SECRET=your-dev-secret-min-32-chars

# Client URL (for CORS — set to your Railway frontend URL)
CLIENT_URL=https://your-summit-app.up.railway.app

# Server port (Railway sets this automatically)
PORT=3000
